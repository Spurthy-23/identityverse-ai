# Copy this file to .env and fill in real values for production.
# The app runs perfectly with NO .env file at all for local development --
# it just uses TinyDB (local file) and falls back to templated AI responses.

# --- MongoDB (optional -- leave blank to use local TinyDB) ---
MONGO_URI=

# --- Groq AI (optional -- leave blank to use fallback templates) ---
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth (off by default) ---
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-long-random-string-in-production

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Synthetic data sizing ---
NUM_USERS=500
NUM_AUDIT_LOGS=10000
RANDOM_SEED=42
